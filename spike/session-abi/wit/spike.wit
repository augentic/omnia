package spike:session;

interface session {
    record tool-call {
        id: string,
        name: string,
        arguments: string,
    }

    record tool-result {
        id: string,
        output: result<string, string>,
    }

    record reply {
        answer: string,
    }

    variant error {
        failed(string),
        budget-exhausted(string),
    }

    /// The corner under test: stream + future nested in a returned record.
    record session {
        calls: stream<tool-call>,
        reply: future<result<reply, error>>,
    }

    /// Guest creates `results`, keeps the writer, passes the readable end.
    /// Host mints `calls` and `reply` and returns their readable ends.
    create: async func(request: string, results: stream<tool-result>) -> result<session, error>;
}

world spike {
    import session;

    /// Scenario driver; diagnostics come back in the return value.
    export run: async func(scenario: string) -> result<string, string>;
}
