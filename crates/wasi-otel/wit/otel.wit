/// A guest's own traces, metrics, and logs, exported as OpenTelemetry
/// Protocol (OTLP) records.
package omnia:otel@0.1.0;

/// The types the telemetry interfaces share.
///
/// Records and fields carry the names of the OpenTelemetry Protocol, OTLP,
/// and mean what OTLP means by them. A field OTLP leaves unset is `none`.
/// A field whose name ends in `-unix-nano` is an instant in nanoseconds
/// since the Unix epoch. One whose name starts with `dropped-` counts the
/// items the guest discarded to keep within its own limits.
///
/// The telemetry is the guest's own. The host adds the resource that
/// identifies the deployment, and sends the telemetry to the collector the
/// deployment configures.
///
/// Every backend carries portable telemetry, and may reject any other as
/// `invalid`:
///
/// - A trace id is 32 lowercase hexadecimal digits and a span id is 16.
///   Neither is all zeros.
/// - An attribute key is not empty, and a list of attributes holds each
///   key once.
/// - The telemetry of one call is at most 4 MiB as an OTLP request.
///
/// An `error` from a telemetry interface means:
///
/// - `not-found`: the collector has no endpoint for the signal.
/// - `denied`: the collector refused the deployment's credentials.
/// - `invalid`: the telemetry was rejected, such as an id that is not
///   hexadecimal. Sending it again fails again.
/// - `unsupported`: a valid export this backend cannot serve.
/// - `unavailable`: the collector did not answer, or the export exceeded
///   its bound.
interface types {
  use omnia:types/types@0.1.0.{error};

  /// The id of a trace, as W3C Trace Context writes it.
  type trace-id = string;

  /// The id of a span, as W3C Trace Context writes it.
  type span-id = string;

  /// The W3C trace flags, as the octet a `traceparent` header carries. Bit
  /// 0 is `sampled` and bit 1 is `random`.
  type trace-flags = u8;

  /// A value, which OTLP calls an `AnyValue`.
  variant any-value {
    string-value(string),
    bool-value(bool),
    int-value(s64),
    double-value(f64),
    bytes-value(list<u8>),
    /// An array whose values are all strings. The next three cases hold
    /// booleans, integers, and doubles.
    string-array(list<string>),
    bool-array(list<bool>),
    int-array(list<s64>),
    double-array(list<f64>),
    /// A map, or an array that is nested or holds more than one type, as
    /// JSON text. An object is a map, and `null` is the empty value. A
    /// number with no fraction or exponent that fits a signed 64-bit
    /// integer is an integer, and any other number is a double. Nothing
    /// inside it is read as bytes. Text that is not JSON is `invalid`.
    json-value(string),
    /// The empty value, which some languages write as `null`.
    empty,
  }

  /// An attribute.
  record key-value {
    key: string,
    value: any-value,
  }

  /// The library or module that produced a batch of telemetry.
  record instrumentation-scope {
    name: string,
    version: option<string>,
    attributes: list<key-value>,
    dropped-attributes-count: u32,
  }
}

/// Spans, and the trace the host is in. Every backend serves this
/// interface.
interface traces {
  use types.{error, instrumentation-scope, key-value, span-id, trace-flags, trace-id};

  /// The `tracestate` header of W3C Trace Context, as it is written.
  type trace-state = string;

  /// Where a span sits in a trace, as W3C Trace Context propagates it.
  record span-context {
    trace-id: trace-id,
    span-id: span-id,
    trace-flags: trace-flags,
    trace-state: option<trace-state>,
  }

  /// The part a span plays in a call between two parties.
  enum span-kind {
    /// Work with no remote party.
    internal,
    /// Handling a request another party sent.
    server,
    /// A request to another party.
    client,
    /// Handing a message to a broker.
    producer,
    /// Handling a message a broker delivered.
    consumer,
  }

  /// How the operation a span covers ended.
  variant status {
    /// The instrumentation set no status.
    unset,
    /// The application marked the operation as successful.
    ok,
    /// The operation failed, with a description where one is given.
    error(option<string>),
  }

  /// A moment within a span.
  record event {
    time-unix-nano: u64,
    name: string,
    attributes: list<key-value>,
    dropped-attributes-count: u32,
  }

  /// A pointer from a span to another span, in any trace.
  record link {
    span-context: span-context,
    /// Whether the linked context arrived from another process. `none`
    /// when unknown.
    is-remote: option<bool>,
    attributes: list<key-value>,
    dropped-attributes-count: u32,
  }

  /// A span that has ended.
  record span {
    span-context: span-context,
    /// `none` for a root span.
    parent-span-id: option<span-id>,
    /// Whether the parent's context arrived from another process. `none`
    /// when unknown, and for a root span.
    parent-is-remote: option<bool>,
    name: string,
    kind: span-kind,
    start-time-unix-nano: u64,
    end-time-unix-nano: u64,
    attributes: list<key-value>,
    dropped-attributes-count: u32,
    events: list<event>,
    dropped-events-count: u32,
    links: list<link>,
    dropped-links-count: u32,
    status: status,
  }

  /// The spans one instrumentation scope produced.
  record scope-spans {
    /// `none` when the scope is unknown.
    scope: option<instrumentation-scope>,
    spans: list<span>,
    /// The schema the spans' names and attributes follow.
    schema-url: option<string>,
  }

  /// The context of the host's span for the call the guest is serving,
  /// `none` when the host has none.
  ///
  /// A root span that takes this context as its parent joins the host's
  /// trace.
  current-span-context: func() -> option<span-context>;

  /// Export spans that have ended.
  ///
  /// The host exports each span as given. `ok` means the host took the
  /// spans for delivery, not that a collector stored them, and a
  /// deployment with no collector drops them. When the host rejects a span
  /// as `invalid` it exports none of the call's spans. An empty list
  /// succeeds.
  %export: async func(scope-spans: list<scope-spans>) -> result<_, error>;
}

/// Metric points. Every backend serves this interface.
interface metrics {
  use types.{error, instrumentation-scope, key-value, span-id, trace-id};

  /// A measured number.
  variant number {
    as-double(f64),
    as-int(s64),
  }

  /// The time each point of a metric covers.
  enum aggregation-temporality {
    /// The time since the previous point.
    delta,
    /// The time since the series started.
    cumulative,
  }

  /// One measurement kept as an example of those a point aggregates.
  record exemplar {
    /// The measurement's attributes that the point's series leaves out.
    filtered-attributes: list<key-value>,
    time-unix-nano: u64,
    value: number,
    /// The span that was current at the measurement. `none` when no
    /// sampled span was.
    span-id: option<span-id>,
    trace-id: option<trace-id>,
  }

  /// One point of a gauge or a sum.
  record number-data-point {
    /// The attributes that identify the point's series.
    attributes: list<key-value>,
    /// When the series started. `none` when unknown.
    start-time-unix-nano: option<u64>,
    time-unix-nano: u64,
    value: number,
    exemplars: list<exemplar>,
  }

  /// The latest value of each series.
  record gauge {
    data-points: list<number-data-point>,
  }

  /// The total of each series.
  record sum {
    data-points: list<number-data-point>,
    aggregation-temporality: aggregation-temporality,
    /// Whether the total only rises.
    is-monotonic: bool,
  }

  /// One point of a histogram with stated bucket bounds.
  record histogram-data-point {
    attributes: list<key-value>,
    start-time-unix-nano: option<u64>,
    time-unix-nano: u64,
    /// How many measurements the point holds.
    count: u64,
    /// `none` where a measurement may be negative.
    sum: option<f64>,
    /// One count for each bucket, which is one more than `explicit-bounds`
    /// holds. Empty when the point keeps no buckets.
    bucket-counts: list<u64>,
    /// The upper bound of every bucket but the last, in rising order.
    explicit-bounds: list<f64>,
    exemplars: list<exemplar>,
    min: option<f64>,
    max: option<f64>,
  }

  /// The distribution of each series, in buckets with stated bounds.
  record histogram {
    data-points: list<histogram-data-point>,
    aggregation-temporality: aggregation-temporality,
  }

  /// A run of bucket counts in an exponential histogram.
  record buckets {
    /// The index of the first bucket.
    offset: s32,
    bucket-counts: list<u64>,
  }

  /// One point of an exponential histogram.
  record exponential-histogram-data-point {
    attributes: list<key-value>,
    start-time-unix-nano: option<u64>,
    time-unix-nano: u64,
    count: u64,
    sum: option<f64>,
    /// The resolution. Each bucket bound is a power of `2^(2^-scale)`.
    scale: s32,
    /// How many measurements lie within `zero-threshold` of zero.
    zero-count: u64,
    positive: buckets,
    negative: buckets,
    exemplars: list<exemplar>,
    min: option<f64>,
    max: option<f64>,
    zero-threshold: f64,
  }

  /// The distribution of each series, in buckets whose bounds grow by a
  /// fixed ratio.
  record exponential-histogram {
    data-points: list<exponential-histogram-data-point>,
    aggregation-temporality: aggregation-temporality,
  }

  /// The points of a metric, by how they were aggregated.
  variant metric-data {
    gauge(gauge),
    sum(sum),
    histogram(histogram),
    exponential-histogram(exponential-histogram),
  }

  /// The points one instrument produced.
  record metric {
    name: string,
    description: option<string>,
    /// The unit of the values, as a UCUM code.
    unit: option<string>,
    data: metric-data,
  }

  /// The metrics one instrumentation scope produced.
  record scope-metrics {
    /// `none` when the scope is unknown.
    scope: option<instrumentation-scope>,
    metrics: list<metric>,
    /// The schema the metrics' names and attributes follow.
    schema-url: option<string>,
  }

  /// Export metric points.
  ///
  /// `ok` means the host took the points for delivery, not that a
  /// collector stored them, and a deployment with no collector drops them.
  /// When the host rejects a point as `invalid` it exports none of the
  /// call's points. An empty list succeeds.
  %export: async func(scope-metrics: list<scope-metrics>) -> result<_, error>;
}

/// Optional: log records.
@unstable(feature = logs)
interface logs {
  @unstable(feature = logs)
  use types.{
    any-value, error, instrumentation-scope, key-value, span-id, trace-flags, trace-id,
  };

  /// One log record.
  @unstable(feature = logs)
  record log-record {
    /// When the event happened. `none` when unknown.
    time-unix-nano: option<u64>,
    /// When the guest observed the event. `none` leaves the host to stamp
    /// the time it took the record.
    observed-time-unix-nano: option<u64>,
    /// OTLP's severity number: 1 to 4 are trace, 5 to 8 debug, 9 to 12
    /// info, 13 to 16 warn, 17 to 20 error, and 21 to 24 fatal. Any other
    /// number is `invalid`.
    severity-number: option<u8>,
    /// The level as the source wrote it.
    severity-text: option<string>,
    body: option<any-value>,
    attributes: list<key-value>,
    dropped-attributes-count: u32,
    /// The span that was current when the record was made. `none` when
    /// none was.
    trace-id: option<trace-id>,
    span-id: option<span-id>,
    trace-flags: option<trace-flags>,
    /// The name of the kind of event the record reports.
    event-name: option<string>,
  }

  /// The log records one instrumentation scope produced.
  @unstable(feature = logs)
  record scope-logs {
    /// `none` when the scope is unknown.
    scope: option<instrumentation-scope>,
    log-records: list<log-record>,
    /// The schema the records' names and attributes follow.
    schema-url: option<string>,
  }

  /// Export log records.
  ///
  /// `ok` means the host took the records for delivery, not that a
  /// collector stored them, and a deployment with no collector drops them.
  /// When the host rejects a record as `invalid` it exports none of the
  /// call's records. An empty list succeeds.
  %export: async func(scope-logs: list<scope-logs>) -> result<_, error>;
}

/// What every backend serves.
world core {
  import types;
  import traces;
  import metrics;
}

/// Every interface. A backend answers `unsupported` for what it does not
/// serve.
///
/// `logs` is unstable, and a guest binds it by enabling the feature of that
/// name. Every host links it.
world imports {
  include core;
  @unstable(feature = logs)
  import logs;
}
