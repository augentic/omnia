// A skewed copy of `omnia-test:link/ops`: the same package and interface
// name, so it links as the same interface, but a different result type from
// the one every guest built from `wit/link.wit` declares. Kept in its own
// directory because one WIT package cannot define `ops` twice.
package omnia-test:link;

interface ops {
    ping: func(target: string, message: string) -> u32;

    ping-async: async func(target: string, message: string) -> u32;
}

/// Serves the skewed `ops`, so seating it beside a `wit/link.wit` importer
/// must be refused.
world skewed {
    export ops;
}

/// Imports the skewed `ping`, so seating it beside a `wit/link.wit` importer
/// must be refused.
world skewed-importer {
    import ops;
    export poke: func(message: string) -> u32;
}
