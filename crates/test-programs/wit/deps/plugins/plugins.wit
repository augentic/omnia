package omnia:plugins@0.1.0;

/// Host-side guest loading. The deployment declares every guest that may
/// run; a caller names one, and the host admits it if it is not active yet.
/// Component bytes, paths, and registry endpoints never cross this
/// interface: the caller supplies a name the deployment already chose.
interface loader {
    /// Why a load was refused.
    variant error {
        /// The request or deployment is wrong and a retry cannot succeed:
        /// the deployment declares no guest of that name, its bytes do not
        /// hash to the declared digest, they are not a loadable component, or
        /// they are pre-compiled where the entry admits raw wasm alone.
        refused(string),
        /// The guest's source could not produce its bytes; the source may
        /// recover, so a retry can succeed.
        unavailable(string),
        /// Loader misconfiguration or an internal registration failure.
        internal(string),
    }

    /// A loaded guest: a plain value, because the caller holds no lifecycle
    /// authority over it.
    record plugin {
        /// The registered guest identity (routes both link dispatch and the
        /// host Dispatcher).
        id: string,
        /// The `sha256:<hex>` content digest of the bytes the guest was
        /// loaded from.
        digest: string,
    }

    /// Ensure the guest the deployment declares as `name` is active and
    /// return its handle: admitted now from its declared source if it loads
    /// on demand, attested if it is already active. Idempotent.
    load: async func(name: string) -> result<plugin, error>;
}

world imports {
    import loader;
}
