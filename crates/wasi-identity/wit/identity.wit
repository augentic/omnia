package omnia:identity@0.1.0;

/// The types the identity interfaces share.
///
/// Every backend accepts a portable name and a portable scope, and may
/// reject any other as `invalid`.
///
/// - A portable identity name is not empty and holds only ASCII letters,
///   digits, `_`, and `-`.
/// - A portable scope is an OAuth 2.0 scope token: one or more printable
///   ASCII characters other than space, `"`, and `\`.
interface types {
  /// Why a call failed.
  variant error {
    /// The identity is not declared by the deployment.
    not-found(string),
    /// The issuer refused the identity a token.
    denied(string),
    /// The request was rejected, such as a scope the issuer does not know.
    invalid(string),
    /// A valid request this backend cannot serve.
    unsupported(string),
    /// The issuer did not answer, or the call exceeded its bound.
    unavailable(string),
    /// Any other failure.
    other(string),
  }

  /// An OAuth 2.0 bearer token and when it expires.
  ///
  /// A caller sends `token` in an `Authorization: Bearer` header.
  record access-token {
    /// The token, opaque to the guest.
    token: string,
    /// When the token expires, in milliseconds since the Unix epoch.
    ///
    /// A backend whose issuer states no expiry reports the lifetime the
    /// issuer documents.
    expires-at: u64,
  }
}

/// Tokens for the identities a deployment declares. Every backend serves
/// this interface.
interface credentials {
  use types.{access-token, error};

  /// An open identity.
  resource identity {
    /// A token for this identity, scoped to `scopes`.
    ///
    /// - An empty `scopes` asks for the identity's default scopes.
    /// - A portable request names one scope. A backend may fail any other
    ///   number with `unsupported`.
    /// - A scope the issuer does not know fails with `invalid`, and one the
    ///   identity may not have with `denied`.
    /// - The host may answer from a cache, so two calls may return the same
    ///   token.
    get-token: async func(scopes: list<string>) -> result<access-token, error>;
  }

  /// Open the identity `name`, a binding the deployment declares. An unnamed
  /// SDK handle opens `default`.
  ///
  /// An undeclared name fails with `not-found`.
  open: async func(name: string) -> result<identity, error>;
}

/// What every backend serves.
world core {
  import types;
  import credentials;
}

/// Every interface. A backend answers `unsupported` for what it does not
/// serve.
world imports {
  include core;
}
