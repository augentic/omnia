package omnia:blobstore@0.1.0;

/// Objects in containers, one function per `BlobStore` method.
///
/// An absent object is `none`, and a call on an object in a container that
/// does not exist fails with `not-found`.
///
/// Every backend stores a portable name, and may reject any other as
/// `invalid`. A portable container name:
///
/// - is 3 to 63 characters long;
/// - holds only lowercase ASCII letters, digits, and `-`;
/// - starts and ends with a letter or digit, and never holds `--`.
///
/// A portable object name is one or more segments joined by `/`. Each
/// segment is not empty, holds only ASCII letters, digits, `.`, `_`, and
/// `-`, and is neither `.` nor `..`. A portable container never holds both
/// an object `a` and an object under `a/`.
interface store {
  /// Why a call failed.
  variant error {
    /// A container, or the source of a copy, does not exist. An absent
    /// object is not an error.
    not-found(string),
    /// The caller may not use the container.
    denied(string),
    /// The request was rejected, such as a name the backend cannot store.
    invalid(string),
    /// A valid request this backend cannot serve.
    unsupported(string),
    /// The backing store did not answer, or the call exceeded its bound.
    unavailable(string),
    /// Any other failure.
    other(string),
  }

  /// A container's metadata.
  record container-metadata {
    /// The container's name.
    name: string,
    /// When the container was created, in seconds since the Unix epoch.
    created-at: u64,
  }

  /// An object's metadata.
  record object-metadata {
    /// The object's name.
    name: string,
    /// The container holding the object.
    container: string,
    /// When the object was written, in seconds since the Unix epoch.
    created-at: u64,
    /// The object's size in bytes.
    size: u64,
  }

  /// One page of a listing.
  record page {
    /// The objects on this page, in name order.
    objects: list<object-metadata>,
    /// The cursor that resumes the listing after this page, `none` on the
    /// last page.
    next: option<string>,
  }

  /// Get the object `name`, `none` when absent.
  get: async func(container: string, name: string) -> result<option<list<u8>>, error>;

  /// Get the bytes of the object `name` from `start` up to `end`, `none`
  /// when absent.
  ///
  /// The range is half-open and clamped to the object's length, so a range
  /// past the end, or one that ends before it starts, reads as empty.
  get-range: async func(container: string, name: string, start: u64, end: u64)
    -> result<option<list<u8>>, error>;

  /// Store `data` as the object `name`, replacing any object there.
  put: async func(container: string, name: string, data: list<u8>) -> result<_, error>;

  /// Delete the object `name`. Deleting an absent object succeeds.
  delete: async func(container: string, name: string) -> result<_, error>;

  /// The metadata of the object `name`, `none` when absent.
  stat: async func(container: string, name: string)
    -> result<option<object-metadata>, error>;

  /// One page of the objects whose names start with `prefix`.
  ///
  /// `after` is the `next` cursor of the previous page, `none` for the
  /// first page.
  %list: async func(container: string, prefix: string, after: option<string>)
    -> result<page, error>;

  /// Create the empty container `container`. Creating one that exists keeps
  /// its objects.
  create-container: async func(container: string) -> result<_, error>;

  /// Delete the container and every object in it. Deleting an absent
  /// container succeeds.
  delete-container: async func(container: string) -> result<_, error>;

  /// Whether the container exists.
  container-exists: async func(container: string) -> result<bool, error>;

  /// The metadata of the container, `none` when it does not exist.
  container-info: async func(container: string)
    -> result<option<container-metadata>, error>;

  /// Whether the object `name` exists.
  exists: async func(container: string, name: string) -> result<bool, error>;

  /// Delete each object in `names`. A name already absent is skipped.
  delete-many: async func(container: string, names: list<string>) -> result<_, error>;

  /// Delete every object in the container, leaving it empty.
  clear: async func(container: string) -> result<_, error>;

  /// Copy an object to the same or a different container, replacing any
  /// object at the destination.
  ///
  /// An absent source fails with `not-found` and writes nothing.
  copy: async func(
    src-container: string, src-name: string, dest-container: string, dest-name: string,
  ) -> result<_, error>;

  /// Move an object to a new name in the same or a different container.
  ///
  /// The move replaces any object at the destination, and fails as `copy`
  /// does, leaving the source in place. Moving an object onto itself keeps
  /// it.
  rename: async func(
    src-container: string, src-name: string, dest-container: string, dest-name: string,
  ) -> result<_, error>;
}

world imports {
  import store;
}
