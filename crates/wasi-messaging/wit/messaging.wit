package omnia:messaging@0.1.0;

/// The types the messaging interfaces share.
///
/// Every backend carries a portable topic, and may reject any other as
/// `invalid`. A portable topic is one or more segments joined by `.`. Each
/// segment is not empty and holds only ASCII letters, digits, `_`, and `-`.
interface types {
  /// A topic, which some brokers call a subject or a channel.
  type topic = string;

  /// A name for a set of topics.
  ///
  /// A pattern is a topic in which a `*` segment stands for any one segment,
  /// and a last segment of `>` for one or more. A topic is a pattern that
  /// names only itself.
  type pattern = string;

  /// The caller's own entries, each name once. No backend interprets them.
  ///
  /// A portable name matches `[a-z][a-z0-9-]*`, and a portable value is
  /// printable ASCII.
  type metadata = list<tuple<string, string>>;

  /// A broker's token for one stored message, opaque to the guest.
  type position = string;

  /// Why a call failed.
  variant error {
    /// The broker or the subscription is not declared by the deployment.
    not-found(string),
    /// The caller may not use the broker or the topic.
    denied(string),
    /// The request was rejected, such as a topic the backend cannot carry.
    invalid(string),
    /// A valid request this backend cannot serve.
    unsupported(string),
    /// The broker did not answer, or the call exceeded its bound.
    unavailable(string),
    /// Any other failure.
    other(string),
  }

  /// A connection to a broker.
  resource client {
    /// Connect to the broker `name`, a binding the deployment declares. An
    /// unnamed SDK handle connects to `default`.
    connect: static async func(name: string) -> result<client, error>;
  }

  /// A message.
  ///
  /// A backend carries every field given or fails with `unsupported`.
  record message {
    /// The payload, opaque to the host.
    data: list<u8>,
    /// The media type of `data`.
    content-type: option<string>,
    /// The sender's id for the message. A broker that removes duplicates
    /// keeps one message for each id it sees within its window.
    id: option<string>,
    /// The ordering key. Where the broker orders by key, messages that
    /// share one arrive in the order they were sent.
    key: option<string>,
    metadata: metadata,
  }

  /// A message as a subscriber receives it.
  record delivery {
    /// The topic the message was sent to.
    topic: topic,
    message: message,
    /// The address `reply` answers, opaque to the guest. `none` when the
    /// sender awaits no reply.
    reply-to: option<string>,
    /// Where the broker stored the message. A redelivery carries the same
    /// position. `none` where the broker stores none.
    position: option<position>,
    /// How many times the broker has delivered the message, counting this
    /// one. `none` where the broker keeps no count.
    attempt: option<u32>,
    /// When the broker took the message, in milliseconds since the Unix
    /// epoch. `none` where the broker records no time.
    published-at: option<u64>,
  }
}

/// Sending messages. Every backend serves this interface.
interface producer {
  use types.{client, message, error, topic};

  /// Send `message` to `topic`.
  ///
  /// `ok` means the backend took the message for delivery, not that a
  /// subscriber received it.
  send: async func(c: borrow<client>, topic: topic, message: message) -> result<_, error>;
}

/// Optional: a request that awaits one reply.
interface request-reply {
  use types.{client, message, error, topic};

  /// Send `message` to `topic` and return the first reply.
  ///
  /// The call waits `timeout-ms` milliseconds, or the backend's bound when
  /// `none`. A request nothing answers in that time fails with
  /// `unavailable`. A zero `timeout-ms` is `invalid`.
  request: async func(
    c: borrow<client>, topic: topic, message: message, timeout-ms: option<u32>,
  ) -> result<message, error>;

  /// Answer the request whose delivery carried `reply-to`.
  reply: async func(reply-to: string, message: message) -> result<_, error>;
}

/// Optional: taking messages in batches and settling each one.
interface consumer {
  use types.{client, delivery, error};

  /// One message the guest holds, which the broker delivers to nobody else
  /// meanwhile.
  ///
  /// A lease ends when it is settled, when the subscription's time limit
  /// passes, or when the handle is dropped. The last two release the
  /// message. A lease settles once.
  resource lease {
    /// The message the lease holds.
    delivery: func() -> delivery;

    /// The message is handled. The broker delivers it no more.
    accept: async func() -> result<_, error>;

    /// Give the message back for another delivery, no sooner than
    /// `delay-ms` milliseconds from now where given.
    release: async func(delay-ms: option<u32>) -> result<_, error>;

    /// The message can never be handled. The broker delivers it no more,
    /// and dead-letters it where the subscription says so.
    reject: async func() -> result<_, error>;

    /// Start the subscription's time limit again.
    renew: async func() -> result<_, error>;
  }

  /// Take up to `max` messages from `subscription`, which the deployment
  /// declares.
  ///
  /// The call returns as soon as a message is ready, and with none once
  /// `wait-ms` milliseconds pass. `max` is at most 1,000, and zero is
  /// `invalid`.
  receive: async func(
    c: borrow<client>, subscription: string, max: u32, wait-ms: u32,
  ) -> result<list<lease>, error>;
}

/// Optional: topics as an ordered log, written under a condition and read
/// back from a position.
interface log {
  use types.{client, message, delivery, position, pattern, error, topic};

  /// What must hold for an append to take effect.
  ///
  /// A backend that cannot check it atomically fails with `unsupported`.
  variant precondition {
    /// The topic holds no message.
    absent,
    /// The newest message the topic holds is at this position.
    matches(position),
  }

  /// An append whose precondition did not hold.
  record conflict {
    /// The position of the newest message found, `none` when the topic
    /// holds none.
    current: option<position>,
  }

  /// Where a read starts.
  variant start {
    /// The oldest message the topics hold.
    first,
    /// The message that follows this position.
    after(position),
    /// The first message the broker took at or after this time, in
    /// milliseconds since the Unix epoch.
    since(u64),
  }

  /// Send `message` to `topic` and return where the broker stored it.
  ///
  /// A message the broker already stored under the same `id` returns the
  /// position of the first.
  append: async func(
    c: borrow<client>, topic: topic, message: message, when: option<precondition>,
  ) -> result<result<position, conflict>, error>;

  /// The messages of the topics `pattern` names, from `start`, oldest first.
  ///
  /// A backend that keeps no one order across those topics fails with
  /// `unsupported`. The list holds at most `limit` messages and never more
  /// than 1,000. A zero `limit` is `invalid`. An empty list means the topics
  /// hold nothing later. A read settles nothing and moves no subscription.
  read: async func(
    c: borrow<client>, pattern: pattern, start: start, limit: option<u32>,
  ) -> result<list<delivery>, error>;
}

/// Optional: listing and purging the topics a broker holds.
interface admin {
  use types.{client, pattern, topic, error};

  /// One page of topic names.
  record names {
    /// The topics on this page, in no particular order.
    topics: list<topic>,
    /// The cursor that resumes the listing. Only `none` marks the last page.
    next: option<string>,
  }

  /// One page of the topics `pattern` names that hold a message.
  ///
  /// A page holds at most `limit` names and never more than 1,000. A zero
  /// `limit` is `invalid`. `after` is the `next` of the previous page.
  list-topics: async func(
    c: borrow<client>, pattern: pattern, after: option<string>, limit: option<u32>,
  ) -> result<names, error>;

  /// Delete the messages of every topic `pattern` names, and return how
  /// many.
  purge-topics: async func(c: borrow<client>, pattern: pattern) -> result<u64, error>;
}

/// The messages a deployment routes to the guest, one call for each.
interface incoming-handler {
  use types.{delivery, error};

  /// Handle one delivery, which a broker may make more than once.
  ///
  /// The host sets the `deadline` entry of the delivery's metadata to when
  /// it stops waiting, as decimal milliseconds since the Unix epoch. What
  /// `handle` returns settles the delivery:
  ///
  /// - `ok` accepts it. The broker delivers the message no more.
  /// - `invalid` rejects it, as a message no redelivery makes handleable.
  ///   The backend drops or dead-letters it.
  /// - `unavailable` releases it, as a failure that may pass. A backend
  ///   that redelivers delivers the message again.
  /// - Any other case is the backend's to decide.
  handle: async func(delivery: delivery) -> result<_, error>;
}

/// What every backend serves.
world core {
  import types;
  import producer;
}

/// Every interface. A backend answers `unsupported` for what it does not
/// serve.
world imports {
  include core;
  import request-reply;
  import consumer;
  import log;
  import admin;
}

/// `core`, and the handler a subscribing guest exports.
world messaging-core {
  include core;
  export incoming-handler;
}

/// `messaging-core`, and request-reply.
world messaging-request-reply {
  include messaging-core;
  import request-reply;
}

/// `imports`, and the handler: the world a host links.
world messaging {
  include imports;
  export incoming-handler;
}
