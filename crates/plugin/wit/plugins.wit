package omnia:plugins@0.2.0;

/// The types the plugin interfaces share.
///
/// Every backend accepts a portable path, reference, registry, and digest,
/// and may reject any other as `invalid`.
///
/// - A portable path names a file as the guest would open it: a mount's
///   name, a `/`, and the path beneath that mount. A path that starts with
///   no mount's name lies beneath `.`. Beneath the mount, segments are
///   joined by `/`, and none is empty, `.`, or `..`, or holds a `\`.
/// - A portable reference is `namespace:name@version`. The namespace and
///   the name are lowercase ASCII words joined by `-`, each starting with a
///   letter. The version is one exact semantic version.
/// - A portable registry is a host name, with an optional `:port`.
/// - A portable digest is `sha256:` and 64 lowercase hexadecimal digits.
///
/// An `error` from a plugin interface means:
///
/// - `not-found`: the source names nothing. No guest is declared or loaded
///   under the name, no file is at the path, or no store or registry holds
///   the release.
/// - `denied`: the deployment does not grant the load, such as a path
///   beneath a writable mount.
/// - `invalid`: the request was rejected, such as a malformed digest, or
///   the bytes are not a component the deployment can run.
/// - `unavailable`: the mount, the store, or the registry did not produce
///   the bytes.
interface types {
  use omnia:types/types@0.1.0.{error};

  /// The digest of a component's bytes.
  ///
  /// The host answers the portable form, so two digests it answers compare
  /// by equality.
  type digest = string;

  /// One exact release of a package.
  record release {
    /// The release, as `namespace:name@version`.
    reference: string,
    /// The registry to fetch the release from. It is read only when the
    /// store does not hold the release.
    ///
    /// - A package the deployment routes is fetched from that registry
    ///   alone, and naming another fails with `denied`.
    /// - A package the deployment routes nowhere is fetched from this one
    ///   and is not kept in the store. Naming none fails with `not-found`.
    /// - A backend that cannot fetch from a named registry fails with
    ///   `unsupported`.
    registry: option<string>,
    /// The digest the release's bytes must hash to, `none` to load
    /// whatever bytes it holds.
    pin: option<digest>,
  }

  /// A component file beneath a read-only mount.
  record file {
    /// The file, as a portable path.
    path: string,
    /// The digest the file's bytes must hash to, `none` to load whatever
    /// bytes it holds.
    pin: option<digest>,
  }

  /// Where a guest's bytes come from, and so the name it loads under.
  ///
  /// The host reads the bytes itself, inside what the deployment grants. No
  /// component bytes cross this interface.
  variant source {
    /// A guest the deployment declares, by its name.
    declared(string),
    /// This file. It loads under the file's name without its extension.
    path(file),
    /// This release, from the deployment's package store when it holds it
    /// and from a registry otherwise. It loads under its reference without
    /// the version.
    release(release),
  }

  /// A loaded guest.
  record plugin {
    /// The name the guest is loaded under, by which a call is routed to it.
    name: string,
    /// The digest of the bytes it was loaded from.
    digest: digest,
    /// The names the component exports: its interfaces, such as
    /// `acme:tool/run@1.0.0`, and its bare functions.
    exports: list<string>,
  }

  /// A load whose precondition did not hold.
  record conflict {
    /// The digest of the bytes the source names.
    found: digest,
    /// The guest already loaded under the name, `none` when none is.
    current: option<plugin>,
  }
}

/// Guests loaded at a guest's request. Every backend serves this
/// interface.
///
/// A deployment has one loader, so there is no handle to open. A loaded
/// guest stays loaded, and no call here unloads or replaces one.
interface loader {
  use types.{conflict, error, plugin, source};

  /// Load the guest `source` names and return it.
  ///
  /// - `declared` returns the guest loaded under the name. When none is, it
  ///   loads the one the deployment declares, held to any digest the
  ///   deployment pins.
  /// - `path` and `release` load raw WebAssembly alone, held to their
  ///   `pin`, and never under a name the deployment declares. A
  ///   pre-compiled component is `invalid`, and a declared name is
  ///   `denied`.
  /// - A source that names nothing fails with `not-found`.
  /// - Loading the same bytes under a name again succeeds and returns the
  ///   guest as it stands.
  /// - A `conflict` loads nothing. The bytes missed the source's `pin`, or
  ///   a guest is loaded under the name from other bytes.
  load: async func(source: source) -> result<result<plugin, conflict>, error>;
}

/// What every backend serves.
world core {
  import types;
  import loader;
}

/// Every interface. A backend answers `unsupported` for what it does not
/// serve.
world imports {
  include core;
}
