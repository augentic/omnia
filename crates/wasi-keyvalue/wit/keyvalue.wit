package omnia:keyvalue@0.1.0;

/// Key-value state, one function per `StateStore` method.
///
/// `bucket` names a binding the deployment declares. An unnamed SDK handle
/// passes `default`.
///
/// Every backend stores a portable key, and may reject any other as
/// `invalid`. A portable key:
///
/// - is not empty;
/// - holds only ASCII letters, digits, `.`, `_`, and `-`;
/// - neither starts nor ends with `.`.
///
/// A TTL is a lifetime the host enforces, in milliseconds:
///
/// - An entry written without one never expires.
/// - A TTL is rounded up to the store's resolution, so an entry never
///   expires early.
/// - A zero TTL is `invalid` and writes nothing.
interface store {
  /// Why a call failed.
  variant error {
    /// The bucket is not declared by the deployment.
    not-found(string),
    /// The caller may not use the bucket.
    denied(string),
    /// The request was rejected, such as a zero TTL or a key the backend
    /// cannot store.
    invalid(string),
    /// A valid request this backend cannot serve.
    unsupported(string),
    /// The backing store did not answer, or the call exceeded its bound.
    unavailable(string),
    /// Any other failure.
    other(string),
  }

  /// A compare-and-swap whose expected value no longer matched.
  record conflict {
    /// The value stored when the swap was attempted, `none` when absent.
    current: option<list<u8>>,
  }

  /// Get the value at `key`, `none` when absent.
  get: async func(bucket: string, key: string) -> result<option<list<u8>>, error>;

  /// Replace the value at `key` and its lifetime.
  set: async func(bucket: string, key: string, value: list<u8>, ttl-ms: option<u64>)
    -> result<_, error>;

  /// Delete the value at `key`. Deleting an absent key succeeds.
  delete: async func(bucket: string, key: string) -> result<_, error>;

  /// Replace the value at `key` with `new` while it still equals `current`
  /// (`none` means absent).
  ///
  /// `ttl-ms` applies only when the swap creates the entry. An existing
  /// entry keeps the time it has left.
  compare-and-swap: async func(
    bucket: string, key: string, current: option<list<u8>>, new: list<u8>,
    ttl-ms: option<u64>,
  ) -> result<result<_, conflict>, error>;

  /// Add `delta` to the counter at `key`, starting from zero, and return
  /// the new value.
  ///
  /// `ttl-ms` applies only when the call creates the counter. An existing
  /// counter keeps the time it has left.
  increment: async func(bucket: string, key: string, delta: s64, ttl-ms: option<u64>)
    -> result<s64, error>;
}

/// `omnia:keyvalue/store` beside the `wasi:keyvalue` draft.
world imports {
  import store;
  include wasi:keyvalue/imports@0.2.0-draft2;
}
