package omnia:keyvalue@0.1.0;

/// Expiry the implementation enforces. `wasi:keyvalue/store` stays standard.
interface ttl {
  use wasi:keyvalue/store@0.2.0-draft2.{bucket, error};
  set: async func(b: borrow<bucket>, key: string, value: list<u8>, ttl-secs: u64)
    -> result<_, error>;
}

world imports {
  import wasi:keyvalue/store@0.2.0-draft2;
  import wasi:keyvalue/atomics@0.2.0-draft2;
  import wasi:keyvalue/batch@0.2.0-draft2;
  import ttl;
}
