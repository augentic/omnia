package omnia:model@0.2.0;

/// The types the model interfaces share.
///
/// Every backend accepts a portable name and a portable value, and may
/// reject any other as `invalid`.
///
/// - A portable model name is not empty and holds only ASCII letters,
///   digits, `_`, and `-`.
/// - A portable tool name is 1 to 64 characters long and holds only ASCII
///   letters, digits, `_`, and `-`. `read`, `list`, and `write` are
///   reserved for the host's tools, and a backend may reserve others.
/// - A portable input schema is a JSON Schema whose root type is `object`.
/// - A portable effort is `low`, `medium`, or `high`.
/// - A portable tool output, tool failure, or correction is at most 1 MiB.
interface types {
  use wasi:filesystem/types@0.3.2.{descriptor};

  /// Why a call failed.
  variant error {
    /// The model is not declared by the deployment, or the place lent does
    /// not exist.
    not-found(string),
    /// The provider refused the caller, or the guest lends a place it does
    /// not hold.
    denied(string),
    /// The request was rejected, such as a reserved tool name or a schema
    /// that is not JSON.
    invalid(string),
    /// A valid request this backend cannot serve.
    unsupported(string),
    /// The provider did not answer, or turned the call away for now as a
    /// rate limit does.
    unavailable(string),
    /// Any other failure.
    other(string),
  }

  /// A JSON document, as text.
  type json = string;

  /// Who wrote a message.
  enum role {
    /// Instructions the model follows.
    system,
    /// Whoever the model answers.
    user,
    /// The model.
    assistant,
  }

  /// One turn of a conversation.
  record message {
    role: role,
    /// The turn's text.
    content: string,
  }

  /// The controls on how the model generates.
  ///
  /// An absent field takes the backend's default. A backend carries every
  /// field given or fails with `unsupported`.
  record generation {
    /// The sampling temperature.
    temperature: option<f32>,
    /// The nucleus sampling threshold.
    top-p: option<f32>,
    /// The most tokens the model writes in one response. A completion that
    /// calls tools takes several responses.
    max-tokens: option<u32>,
    /// Texts at which the model stops writing.
    stop-sequences: list<string>,
    /// The seed that makes sampling repeatable.
    seed: option<u64>,
    /// How much the model reasons before it answers. A level the backend
    /// does not know is `invalid`.
    effort: option<string>,
  }

  /// A named JSON Schema.
  record schema {
    /// The name the provider knows the schema by, portable as a tool name
    /// is.
    name: string,
    /// The JSON Schema document.
    schema: json,
  }

  /// The shape an answer should take.
  ///
  /// A backend steers the model toward it and may hold a candidate to it.
  /// It guarantees nothing about the answer, which only a `check` judges.
  variant format {
    /// Plain text.
    text,
    /// A JSON object.
    json,
    /// JSON that follows the schema.
    schema(schema),
  }

  /// A tool the guest runs for the model.
  record tool {
    name: string,
    /// What the tool does, for the model to read.
    description: option<string>,
    /// The JSON Schema of the tool's arguments.
    input-schema: json,
  }

  /// A place beneath an authorised mount.
  ///
  /// The host resolves it against the mounts the guest holds, so nothing
  /// outside a mount is reached.
  record location {
    /// A mount root the guest holds. Any other descriptor is `denied`.
    root: borrow<descriptor>,
    /// A `/`-separated relative path beneath `root`. No segment is empty,
    /// `.`, or `..`, and none holds `\`. An empty path names the root
    /// itself.
    subpath: string,
  }

  /// What a backend's worker may reach beyond the workspace.
  ///
  /// A worker is a process the backend runs for the completion, such as a
  /// command the model asks for. The guest states the grant, because it
  /// knows the toolchain the completion runs. A grant is a ceiling, so a
  /// backend that runs no worker honours it. An entry that breaks its
  /// shape is `invalid`.
  record worker-grant {
    /// The host names the worker may connect to. Each is a whole name, or
    /// `*.suffix` for a domain and every host beneath it. None is an IP
    /// literal, and none carries a port, a scheme, or a path.
    egress: list<string>,
    /// The directories the worker may read beside the workspace. Each is
    /// `~/<path>` beneath the operator's home, where `<path>` is not empty
    /// and follows the rule of `location.subpath`. A directory the machine
    /// lacks grants nothing.
    read: list<string>,
    /// The environment variables set for the worker.
    ///
    /// A name matches `[A-Za-z_][A-Za-z0-9_]*`. A leading `~/` in a value
    /// stands for the operator's home.
    env: list<tuple<string, string>>,
  }

  /// What the guest lends a completion.
  record grants {
    /// The directory the completion works in, `none` to lend none. The
    /// model reads it, and writes it where the mount and the backend allow.
    workspace: option<location>,
    /// What the backend's worker may reach beyond `workspace`. A grant
    /// given without a workspace is `invalid`.
    worker: option<worker-grant>,
  }

  /// A request to run one of the request's tools.
  record tool-call {
    /// Names the call within its session.
    id: string,
    /// The name of the tool to run.
    name: string,
    /// The arguments, a JSON object. The host does not hold them to the
    /// tool's `input-schema`.
    arguments: json,
  }

  /// An answer the model proposes.
  record candidate {
    /// Names the call within its session.
    id: string,
    /// The text proposed.
    answer: string,
  }

  /// What the host asks of the guest while a completion runs.
  variant call {
    /// Run a tool.
    tool(tool-call),
    /// Judge a candidate answer.
    check(candidate),
  }

  /// What a tool call produced.
  record tool-result {
    /// The `id` of the call this answers.
    id: string,
    /// The tool's output, or why it failed. The model reads either, and a
    /// failure leaves it free to call again.
    output: result<string, string>,
  }

  /// The guest's judgement of a candidate.
  record verdict {
    /// The `id` of the call this answers.
    id: string,
    /// `ok` accepts the candidate as the answer. An error is the
    /// correction the model reads before it proposes another.
    outcome: result<_, string>,
  }

  /// The guest's answer to one call.
  variant call-result {
    tool(tool-result),
    check(verdict),
  }

  /// The tokens a completion spent, counted over every response the model
  /// wrote.
  record usage {
    /// The tokens the model read, cached ones included.
    input-tokens: u64,
    /// The tokens the model wrote, reasoning included.
    output-tokens: u64,
    /// The part of `output-tokens` spent on reasoning. `none` where the
    /// backend keeps no count.
    reasoning-tokens: option<u64>,
    /// The part of `input-tokens` read from a cache. `none` where the
    /// backend keeps no count.
    cache-read-tokens: option<u64>,
    /// The part of `input-tokens` written to a cache. `none` where the
    /// backend keeps no count.
    cache-write-tokens: option<u64>,
  }

  /// A completion's answer.
  record reply {
    /// The text the guest's check accepted, or the model's last text where
    /// the request set no check.
    answer: string,
    /// `none` where the backend reports no usage.
    usage: option<usage>,
  }

  /// A completion that spent a budget before it had an answer.
  ///
  /// The deployment sets the budgets. They bound:
  ///
  /// - the responses the model writes, and the tokens in them;
  /// - the tool calls a completion makes;
  /// - the time the guest takes to answer a call;
  /// - the time the completion takes.
  record exhausted {
    /// Which budget ran out, for a person to read.
    detail: string,
    /// `none` where the backend reports no usage.
    usage: option<usage>,
  }
}

/// Completions by the models a deployment declares. Every backend serves
/// this interface.
///
/// A completion runs the model until it has an answer. On the way the model
/// may call the guest's tools, and the guest may judge each answer it
/// proposes.
interface completion {
  use types.{
    call, call-result, error, exhausted, format, generation, grants, message, reply, tool,
  };

  /// What the guest asks of a model.
  record request {
    /// Standing instructions, read before `messages`.
    system: option<string>,
    /// The conversation so far, oldest first. A request whose messages
    /// hold no text is `invalid`.
    messages: list<message>,
    /// `none` takes the backend's defaults.
    generation: option<generation>,
    format: format,
    /// The tools the guest runs for the model.
    tools: list<tool>,
    grants: grants,
    /// Whether the guest judges each candidate answer.
    ///
    /// When set, each candidate arrives on the session's `calls` as a
    /// `check`, and the reply is the first one the guest accepts.
    check: bool,
  }

  /// A completion in progress.
  ///
  /// - Calls may be outstanding together. The guest answers each by its
  ///   `id`, in any order.
  /// - A result that answers no outstanding call is dropped.
  /// - A result of the wrong kind for its call fails the completion with
  ///   `invalid`. So does closing `results` or dropping `calls` while a
  ///   call is outstanding.
  /// - Dropping `reply` abandons the completion.
  record session {
    /// What the host asks of the guest. The stream ends when the
    /// completion does.
    calls: stream<call>,
    /// The answer, or why there is none. The host always resolves it.
    reply: future<result<result<reply, exhausted>, error>>,
  }

  /// An open model.
  resource model {
    /// Begin a completion of `request`.
    ///
    /// The guest keeps the writing end of `results`, and answers each call
    /// of the session through it. A request the host rejects fails here.
    /// Any later failure arrives on the session's `reply`.
    complete: async func(request: request, results: stream<call-result>)
      -> result<session, error>;
  }

  /// Open the model `name`, a binding the deployment declares. The SDK
  /// opens `default` for a request that names no model.
  ///
  /// An undeclared name fails with `not-found`, here or on the first
  /// completion.
  open: async func(name: string) -> result<model, error>;
}

/// Optional: tools served by Model Context Protocol servers, which the
/// backend calls itself.
///
/// The guest runs none of these tools and sees none of their calls.
interface mcp {
  use types.{call-result, error};
  use completion.{model, request, session};

  /// A server whose tools the model may call.
  ///
  /// A backend carries every field given or fails with `unsupported`.
  record server {
    /// Names the server to the model, portable as a tool name is.
    name: string,
    /// The server's HTTP endpoint.
    url: string,
    /// The bearer token the backend sends the server, `none` to send none.
    authorization: option<string>,
    /// The tools the model may call, `none` for every tool the server
    /// lists. An empty list is `invalid`.
    allowed-tools: option<list<string>>,
  }

  /// Begin a completion as `model.complete` does, with the tools of
  /// `servers` offered beside the request's own.
  ///
  /// It fails as `model.complete` does.
  complete: async func(
    model: borrow<model>, request: request, servers: list<server>,
    results: stream<call-result>,
  ) -> result<session, error>;
}

/// What every backend serves.
world core {
  import types;
  import completion;
}

/// Every interface. A backend answers `unsupported` for what it does not
/// serve.
world imports {
  include core;
  import mcp;
}
