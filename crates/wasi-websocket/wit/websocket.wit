package omnia:websocket@0.1.0;

/// The types the WebSocket interfaces share.
///
/// Every backend carries a portable message and close frame, and may
/// reject any other as `invalid`.
///
/// - A portable message is at most 128 KiB, counting text as UTF-8.
/// - A portable close code is 1000, or from 3000 to 4999.
///
/// An `error` from a WebSocket interface means:
///
/// - `not-found`: the service is not declared by the deployment. A
///   connection that is not open is not an error.
/// - `invalid`: the request was rejected, such as a message over the
///   backend's bound, or a close code no endpoint may send.
/// - `unavailable`: the service did not answer, or the call exceeded its
///   bound.
interface types {
  use omnia:types/types@0.1.0.{error, timestamp};

  /// A backend's id for one connection, opaque to the guest.
  ///
  /// Each event carries the id of the connection that sent it. An id is
  /// compared only for equality, and a backend never gives a closed
  /// connection's id to another.
  type connection-id = string;

  /// The name a backend gives a message, which the deployment's routes
  /// match.
  type route = string;

  /// Entries that travel beside a message, each name once.
  ///
  /// A name matches `[a-z][a-z0-9-]*`, as a portable messaging name does,
  /// and a value is printable ASCII.
  type metadata = list<tuple<string, string>>;

  /// A message, which RFC 6455 carries in text or binary frames.
  ///
  /// A backend sends each kind in its own frame type, or fails with
  /// `unsupported`.
  variant message {
    /// Text, which travels as UTF-8.
    text(string),
    /// Bytes, opaque to the host.
    binary(list<u8>),
  }

  /// The status a close frame carries.
  record close-frame {
    /// The status code, as RFC 6455 section 7.4 defines it.
    code: u16,
    /// Why the connection closed, at most 123 bytes of UTF-8.
    reason: string,
  }

  /// A guest's handle on a WebSocket service, the server or gateway its
  /// peers connect to.
  resource client {
    /// Connect to the service `name`, a binding the deployment declares. The
    /// SDK's `DEFAULT` names the service `default`. A name the deployment
    /// does not declare fails with `not-found`.
    connect: static async func(name: string) -> result<client, error>;
  }

  /// A message a connection sent, as the handler receives it.
  record event {
    /// The connection that sent the message.
    connection: connection-id,
    /// The route the backend gave the message, `none` where it gives none.
    route: option<route>,
    message: message,
    /// The entries the backend keeps for the connection.
    metadata: metadata,
    /// When the host stops waiting for `handle` to return.
    deadline: option<timestamp>,
  }
}

/// The connections peers hold open. Every backend serves this interface.
interface connections {
  use types.{client, close-frame, connection-id, error, message};

  /// Send `message` to each of `connections`.
  ///
  /// `ok` means the backend took the message for delivery, not that a peer
  /// received it. A connection that is not open is skipped.
  send: async func(client: borrow<client>, connections: list<connection-id>, message: message)
    -> result<_, error>;

  /// Close `connection`, sending `frame` to its peer.
  ///
  /// `none` sends a close frame with no status code. A backend that cannot
  /// send `frame` fails with `unsupported`. Closing a connection that is not
  /// open succeeds.
  close: async func(
    client: borrow<client>, connection: connection-id, frame: option<close-frame>,
  ) -> result<_, error>;

  /// Whether `connection` is open.
  exists: async func(client: borrow<client>, connection: connection-id)
    -> result<bool, error>;
}

/// Optional: sending to every open connection.
interface broadcast {
  use types.{client, connection-id, error, message};

  /// Send `message` to every connection open on the service, except those
  /// in `except`.
  ///
  /// `ok` means the backend took the message for delivery, not that a peer
  /// received it. An id in `except` that is not open is skipped.
  send: async func(client: borrow<client>, message: message, except: list<connection-id>)
    -> result<_, error>;
}

/// The messages a deployment routes to the guest, one call for each.
interface incoming-handler {
  use types.{error, event};

  /// Handle one message a connection sent.
  ///
  /// The host sets the event's `deadline`. An error leaves the connection
  /// open.
  handle: async func(event: event) -> result<_, error>;
}

/// What every backend serves.
world core {
  import types;
  import connections;
}

/// Every interface. A backend answers `unsupported` for what it does not
/// serve.
world imports {
  include core;
  import broadcast;
}

/// `core`, and the handler a guest exports to receive messages.
world websocket-core {
  include core;
  export incoming-handler;
}

/// `imports`, and the handler: the world a host links.
world websocket {
  include imports;
  export incoming-handler;
}
