mod runtime {
    use anyhow::Result;
    use omnia::futures::future;
    use omnia::Server;
    use omnia::tokio;
    use super::*;
    use omnia::Backend;
    #[derive(Clone)]
    struct Backends {
        redis: Redis,
        otel_default: OtelDefault,
    }
    impl omnia::Backends for Backends {
        async fn connect() -> Result<Self> {
            let (redis, otel_default) = tokio::try_join!(
                < Redis as Backend > ::connect(), < OtelDefault as Backend > ::connect(),
            )?;
            Ok(Self { redis, otel_default })
        }
    }
    impl omnia_wasi_keyvalue::HasKeyValue for Backends {
        fn keyvalue_ctx(&mut self) -> &mut dyn omnia_wasi_keyvalue::WasiKeyValueCtx {
            &mut self.redis
        }
    }
    impl omnia_wasi_otel::HasOtel for Backends {
        fn otel_ctx(&mut self) -> &mut dyn omnia_wasi_otel::WasiOtelCtx {
            &mut self.otel_default
        }
    }
    impl omnia_wasi_messaging::HasMessaging for Backends {
        fn messaging_ctx(&mut self) -> &mut dyn omnia_wasi_messaging::WasiMessagingCtx {
            &mut self.redis
        }
    }
    struct Hooks;
    impl omnia::Wiring<Backends> for Hooks {
        fn link(
            deployment: &mut omnia::Deployment<omnia::StoreCtx<Backends>>,
        ) -> Result<()> {
            deployment.host::<WasiKeyValue, Backends>()?;
            deployment.host::<WasiOtel, Backends>()?;
            deployment.host::<WasiMessaging, Backends>()?;
            Ok(())
        }
        async fn serve(runtime: &omnia::Runtime<Backends>) -> Result<()> {
            let servers: Vec<future::BoxFuture<'_, Result<()>>> = vec![
                Box::pin(WasiMessaging.run(runtime)),
            ];
            future::try_join_all(servers).await?;
            Ok(())
        }
    }
    /// Entry point: run the compiled-in deployment through this
    /// runtime's hosts and backends (raw argv passthrough for a
    /// command deployment compiled in here, otherwise the standard
    /// `run` grammar).
    #[tokio::main]
    pub async fn main() -> ::std::process::ExitCode {
        omnia::main::<Backends, Hooks>(omnia::MainOptions::new(omnia::Mode::Server))
            .await
    }
    /// Run one deployment through this runtime's hosts and backends,
    /// blocking until the guest completes.
    #[tokio::main]
    pub async fn run(builder: omnia::DeploymentBuilder) -> Result<omnia::ExitStatus> {
        omnia::run::<Backends, Hooks>(builder.mode(omnia::Mode::Server)).await
    }
}
#[allow(unused_imports)]
pub use runtime::{run, main};
