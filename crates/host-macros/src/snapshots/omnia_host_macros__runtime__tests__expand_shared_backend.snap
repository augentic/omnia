mod runtime {
    use omnia::anyhow::Result;
    use omnia::futures::future;
    use omnia::tokio;
    use super::*;
    use omnia::Backend;
    #[derive(Clone)]
    struct Backends {
        backend_0: Redis,
        backend_1: OtelDefault,
    }
    impl omnia::ConnectAll for Backends {
        async fn connect() -> Result<Self> {
            let (backend_0, backend_1) = tokio::try_join!(
                < Redis as Backend > ::connect(), < OtelDefault as Backend > ::connect(),
            )?;
            Ok(Self { backend_0, backend_1 })
        }
    }
    impl omnia::Provides<WasiKeyValue> for Backends {
        fn borrow(&mut self) -> <WasiKeyValue as omnia::HostCtx>::Borrow<'_> {
            &mut self.backend_0
        }
    }
    impl omnia::Provides<WasiOtel> for Backends {
        fn borrow(&mut self) -> <WasiOtel as omnia::HostCtx>::Borrow<'_> {
            &mut self.backend_1
        }
    }
    impl omnia::Provides<WasiMessaging> for Backends {
        fn borrow(&mut self) -> <WasiMessaging as omnia::HostCtx>::Borrow<'_> {
            &mut self.backend_0
        }
    }
    /// This runtime's host wiring, generic over the bundle carrying
    /// its hosts' contexts: the compiled-in bundle under `main` and
    /// `run`, any other under `run_with`.
    pub struct Hooks;
    impl<B> omnia::Wiring<B> for Hooks
    where
        B: omnia::Backends,
        B: omnia::Provides<WasiKeyValue>,
        B: omnia::Provides<WasiOtel>,
        B: omnia::Provides<WasiMessaging>,
    {
        fn link(deployment: &mut omnia::Deployment<B>) -> Result<()> {
            deployment.host::<WasiKeyValue>()?;
            deployment.host::<WasiOtel>()?;
            deployment.host::<WasiMessaging>()?;
            Ok(())
        }
        async fn serve(runtime: &omnia::Runtime<B>) -> Result<()> {
            let servers: Vec<future::BoxFuture<'_, Result<()>>> = vec![
                Box::pin(< WasiKeyValue as omnia::Host < B >> ::run(runtime)), Box::pin(<
                WasiOtel as omnia::Host < B >> ::run(runtime)), Box::pin(< WasiMessaging
                as omnia::Host < B >> ::run(runtime)),
            ];
            future::try_join_all(servers).await?;
            Ok(())
        }
    }
    /// The deployment compiled in here (`manifest:` or the inline
    /// manifest keys; empty when neither is declared), for an
    /// embedder to overlay before `run_with`.
    pub fn manifest() -> omnia::ManifestSource {
        omnia::ManifestSource::Inline(omnia::Manifest::new())
    }
    /// Entry point: run the compiled-in deployment through this
    /// runtime's hosts and backends (raw argv passthrough for a
    /// command deployment compiled in here, otherwise the standard
    /// `run` grammar).
    #[tokio::main]
    pub async fn main() -> ::std::process::ExitCode {
        omnia::main::<
            Backends,
            Hooks,
        >(
                omnia::MainOptions::new(omnia::Mode::Server)
                    .program_name(env!("CARGO_PKG_NAME")),
            )
            .await
    }
    /// Run one deployment through this runtime's hosts and backends,
    /// blocking until the guest completes.
    #[tokio::main]
    pub async fn run(builder: omnia::DeploymentBuilder) -> Result<omnia::ExitStatus> {
        let deployment = builder.mode(omnia::Mode::Server).build::<Backends>().await?;
        omnia::run::<Backends, Hooks>(deployment).await
    }
    /// Run one deployment through this runtime's hosts over a bundle
    /// already in hand — nothing connects.
    pub async fn run_with<B>(
        builder: omnia::DeploymentBuilder,
        backends: B,
    ) -> Result<omnia::ExitStatus>
    where
        B: omnia::Backends,
        Hooks: omnia::Wiring<B>,
    {
        let deployment = builder.mode(omnia::Mode::Server).build::<B>().await?;
        omnia::run_with::<B, Hooks>(deployment, backends).await
    }
}
#[allow(unused_imports, reason = "a nested-module invocation uses only some re-exports")]
pub use runtime::{Hooks, main, manifest, run, run_with};
